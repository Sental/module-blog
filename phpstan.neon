includes:
    - vendor/bitexpert/phpstan-magento/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
parameters:
    level: 8
    paths:
        - Api
        - Block
        - Controller
        - Cron
        - Model
        - Plugin
        - Ui
        - ViewModel
    treatPhpDocTypesAsCertain: false
    parallel:
        maximumNumberOfProcesses: 1
